// Copy this file to `Secrets.xcconfig` and fill in the actual values.
// The real file is gitignored — never commit credentials.
//
// Each row's status is visible in the app at Settings → Integrations.
// Missing/empty values keep the feature inert (button disabled with hint).

// --- AI: Gemini (sketch rendering, VTO, style suggestions) ---
// Get a free key at: https:/$()/aistudio.google.com/apikey
GEMINI_API_KEY =

// --- Email: SendGrid (Wave 3) ---
// Sign up: https:/$()/sendgrid.com. SENDGRID_FROM must be a verified sender.
// Format: "Boutique Name <hello@boutique.in>" OR plain email.
SENDGRID_API_KEY =
SENDGRID_FROM =

// --- SMS: Twilio (Wave 3) ---
// Sign up: https:/$()/twilio.com. India: DLT registration required for
// commercial SMS to Indian numbers (Twilio doesn't enforce — sender's job).
TWILIO_SID =
TWILIO_AUTH_TOKEN =
TWILIO_FROM =

// --- Razorpay payment links (Wave 4) ---
// Get test keys: https:/$()/dashboard.razorpay.com/app/keys
// Test keys (rzp_test_*) work without merchant KYC. Live keys (rzp_live_*)
// require KYC + business verification.
RAZORPAY_KEY_ID =
RAZORPAY_KEY_SECRET =
